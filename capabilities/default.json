{
  "identifier": "default",
  "windows": ["main"],
  "commands": [
    "note:list",
    "note:open",
    "note:save",
    "note:create",
    "note:delete",
    "store:get",
    "store:set",
    "store:del",
    "store:keys",
    "http:get",
    "http:post",
    "http:postStream",
    "log:write",
    "clipboard:write",
    "report",
    "notes:env",
    "system:version"
  ],
  "permissions": ["store:default", "http:default", "log:default", "clipboard:default"],
  "scopes": {
    "http": {
      "allow": [
        "api.deepseek.com",
        "api.openai.com",
        "open.bigmodel.cn",
        "dashscope.aliyuncs.com",
        "api.moonshot.cn",
        "*.openai.azure.com",
        "127.0.0.1",
        "localhost"
      ]
    }
  },
  "events": ["http:chunk", "menu:click"]
}
